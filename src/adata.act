"""Base classes for YANG-modeled data classes (MData)
"""

import schema as yschema
import gdata as ygdata
from data import from_data, YangData, PathElement, YangValidationError
from data import coerce_integer_value, unwrap_key
from data import OP_CREATE, OP_DELETE, OP_REMOVE, OP_REPLACE, OP_MERGE

class MNode(object):
    mut def to_gdata(self, prev: ?ygdata.Container=None) -> ygdata.Node:
        raise NotImplementedError("to_gdata")

    mut def copy(self) -> Self:
        """Create a deep copy of this adata object"""
        raise NotImplementedError()


class MList[T(MNode)](MNode):
    """List of YANG list entries"""
    # _elements is internal and may only be updated via the generated create()
    # method or the Indexed protocol in MKeyedList
    _elements: list[T]
    mut def __init__(self, elements: list[T]) -> None:
        self._elements = elements

    mut def _append(self, e: T) -> None:
        self._elements.append(e)


extension MList[T(MNode)](Collection[T]):
    def __iter__(self) -> Iterator[T]:
        return self._elements.__iter__()

    @staticmethod
    def __fromiter__(iterable):
        # The Collection protocol needs this, but a generated list class is only
        # ever built from its own entries by its own __init__. The parameter is
        # deliberately unannotated: Iterable[T] does not unify with the
        # protocol's static signature
        raise NotImplementedError("MList.__fromiter__")

    def __len__(self) -> int:
        return len(self._elements)


class MKeyedList[K(Hashable), T(MNode)](MList[T]):
    """List with (compound) key of Acton type K, found through an index

    K is the Acton type of the scalar key leaf, or a tuple of the key leaf types
    for lists with compound keys. Lookups go through a dict[K, int] rather than
    scanning, so K has to be Hashable.
    """
    @property
    _key_of: pure(T) -> K
    # position of the key in MList._elements
    _index: dict[K, int]

    mut def __init__(self, key_of: pure(T) -> K, elements: list[T]) -> None:
        MList.__init__(self, elements)
        self._key_of = key_of
        self._index = {}
        self._reindex()

    mut def _reindex(self) -> None:
        """Rebuild the key index from _elements"""
        index = {}
        for i, e in enumerate(self._elements):
            k = self._key_of(e)
            # On duplicate keys the first element wins
            if k not in index:
                index[k] = i
        self._index = index

    mut def _append(self, e: T) -> None:
        k = self._key_of(e)
        if k not in self._index:
            self._index[k] = len(self._elements)
        self._elements.append(e)

    pure def get(self, key: K) -> ?T:
        i = self._index.get(key)
        if i is not None:
            return self._elements[i]


extension MKeyedList[K(Hashable), T(MNode)](Indexed[K, T]):
    def __getitem__(self, key: K) -> T:
        e = self.get(key)
        if e is not None:
            return e
        raise KeyError(key)

    mut def __setitem__(self, key: K, n: T) -> None:
        nkey = self._key_of(n)
        if nkey != key:
            raise ValueError("cannot assign entry keyed {nkey} at key {key}; delete and re-create to change a key")
        i = self._index.get(key)
        if i is None:
            self._append(n)
            return
        self._elements[i!] = n

    mut def __delitem__(self, key: K) -> None:
        i = self._index.get(key)
        if i is None:
            raise KeyError(key)
        del self._elements[i!]
        # Everything after i shifted down
        self._reindex()


extension MNode (YangData):
    def take_container(self, schema: yschema.DContainer, ns_qualified: bool, path: list[PathElement]=[]) -> ?(op: ?str, val: ?value):
        maybe_cnt = self.__get_attr__(schema.adata_name!)
        if maybe_cnt is not None:
            return (op=None, val=maybe_cnt)

    def take_list(self, schema: yschema.DList, ns_qualified: bool, path: list[PathElement]=[]) -> list[(op: ?str, key: dict[str, value], val: value)]:
        new_path = path + [PathElement(schema)]
        maybe_list = self.__get_attr__(schema.adata_name!)
        if isinstance(maybe_list, MList):
            key_names = [yschema.list_key_child(schema, k).adata_name! for k in schema.key]
            def element_key(entry: MNode) -> dict[str, value]:
                return {schema.key[i]: unwrap_key(schema.key[i], entry.__get_attr__(key_names[i]), new_path) for i in range(len(key_names))}
            return [(op=None, key=element_key(e), val=e) for e in maybe_list]
        return []

    def take_leaf(self, root: yschema.DRoot, schema: yschema.DLeaf, ns_qualified: bool, path: list[PathElement]=[]) -> ?(op: ?str, val: ?value):
        new_path = path + [PathElement(schema)]
        maybe_attr = self.__get_attr__(schema.adata_name!)
        if maybe_attr is not None:
            schema_type = schema.type
            v = try_validate_mnode_value(maybe_attr, schema_type, new_path)
            if isinstance(v, _Remove):
                return (op=OP_REMOVE, val=None)
            if v is not None:
                return (op=None, val=v)
            raise YangValidationError(path, schema_type, maybe_attr)

    def take_leaflist(self, root: yschema.DRoot, schema: yschema.DLeafList, ns_qualified: bool, path: list[PathElement]=[]) -> list[(op: ?str, val: ?value)]:
        new_path = path + [PathElement(schema)]
        values: list[(op: ?str, val: ?value)] = []
        children = self.__get_attr__(schema.adata_name!)
        if isinstance(children, list):
            schema_type = schema.type
            for child in children:
                v = try_validate_mnode_value(child, schema_type, new_path)
                if v is not None and not isinstance(v, _Remove):
                    values.append((op=None, val=v))
                else:
                    raise YangValidationError(path, schema_type, child)
        return values


class _Remove:
    """An adata empty value set to False, which removes the leaf"""
    def __init__(self):
        pass


def try_validate_mnode_value(val: value, schema_type: yschema.DType, path: list[PathElement]) -> ?value:
    """Validate an adata value against a schema type and return its gdata value

    adata holds an empty value as a bool: True returns Present() and False
    returns _Remove().
    """
    if isinstance(schema_type, yschema.DTypeUnion):
        # A member that takes the value wins over an empty member removing it
        remove: ?value = None
        for alt_type in schema_type.types:
            v = try_validate_mnode_value(val, alt_type, path)
            if isinstance(v, _Remove):
                remove = v
            elif v is not None:
                return v
        return remove
    elif isinstance(schema_type, yschema.DTypeLeafref):
        target_type = schema_type.target_type
        if target_type is not None:
            return try_validate_mnode_value(val, target_type, path)
    elif isinstance(schema_type, yschema.DTypeInteger):
        intval = coerce_integer_value(val, schema_type, path)
        if intval is not None and schema_type.validate_value(intval):
            return intval
    elif isinstance(schema_type, yschema.DTypeBits):
        if isinstance(val, iset):
            # TODO(acton#2969): drop the iset[str] annotation once
            # value-narrowing unboxes set elements.
            sv: iset[str] = val
            try:
                return schema_type.canonical_bits(list(sv))
            except ValueError:
                return None
    elif isinstance(schema_type, yschema.DTypeEmpty):
        if isinstance(val, bool):
            if val:
                return ygdata.Present()
            return _Remove()
    else:
        if schema_type.validate_value(val):
            return val
    return None


def from_adata(root: yschema.DRoot, data: MNode, loose: bool=False, root_path: list[str]=[], prev: ?ygdata.Container=None) -> ygdata.Container:
    def type_narrower(v):
        if isinstance(v, MNode):
            return v
        raise ValueError("Value is not an yang.adata.MNode: {type(v)}")

    return from_data(root, data, type_narrower, loose, root_path, prev)


class ToGdataPrevWrapper(object):
    """Convert adata to gdata and pass it to an update callback

    Keeps the gdata tree it sent previously and passes it as prev to to_gdata in
    the next update
    """
    @property
    wrapped: action(?ygdata.Node) -> None
    prev: ?ygdata.Container

    def __init__(self, wrapped: action(?ygdata.Node) -> None):
        self.wrapped = wrapped
        self.prev = None

    proc def update(self, data: ?MNode) -> None:
        new_data = data?.to_gdata(self.prev)
        self.wrapped(new_data)
        self.prev = new_data if isinstance(new_data, ygdata.Container) else None

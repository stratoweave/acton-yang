import testing


SIGNED_INT_TYPES = {"int8", "int16", "int32", "int64"}
UNSIGNED_INT_TYPES = {"uint8", "uint16", "uint32", "uint64"}

MAX_INT = 9223372036854775807
MIN_INT = -9223372036854775807 - 1
# 10**19 already exceeds an int, so no shift beyond this can fit one
MAX_POW10 = 18
# Decimal holds decimal64, whose exponent is -fraction-digits, i.e. -18..0. The
# bound is far looser than that, and only keeps exponent arithmetic in range.
MAX_EXPONENT = 1000


def _int_repr(v: int) -> str:
    """repr of an int, in a form that can be written back as Acton source

    MIN_INT has no literal form, since 9223372036854775808 is itself out of
    range. https://github.com/actonlang/acton/issues/2545
    """
    if v == MIN_INT:
        return "{MIN_INT + 1} - 1"
    return str(v)


def _mul_pow10(s: int, k: int) -> ?int:
    """s * 10**k, or None when the product does not fit an int

    k must not be negative.
    """
    if s == 0:
        return 0
    if k == 0:
        return s
    if k > MAX_POW10 or s == MIN_INT:
        return None
    m = -s if s < 0 else s
    p = 10**k
    # A negative product may reach MIN_INT, one past -MAX_INT, but only if 10**k
    # divides 2**63. It does not for k > 0, so this bound is exact either way.
    if m > MAX_INT // p:
        return None
    return s * p


def _div_pow10(s: int, k: int) -> int:
    """s // 10**k, truncated toward zero. k must not be negative."""
    if k == 0:
        return s
    if k > MAX_POW10:
        return 0 # |s| < 10**19, so the quotient truncates to zero
    return s // 10**k


class Decimal(object):
    significand: int
    exponent: int

    def __init__(self, significand: int, exponent: int):
        self.significand = significand
        self.exponent = exponent

    def __str__(self):
        # Build from the digits rather than from integral_part()/fractional_part(),
        # so that a negative value does not carry its sign into both halves.
        t = str(self.significand)
        neg = t.startswith("-")
        digits = t[1:] if neg else t
        e = self.exponent
        if e >= 0:
            res = digits + "0" * e
        else:
            n = -e
            digits = digits.zfill(n + 1)
            cut = len(digits) - n
            res = digits[:cut] + "." + digits[cut:]
        return "-" + res if neg else res

    def __repr__(self):
        return "Decimal({_int_repr(self.significand)}, {_int_repr(self.exponent)})"

    @staticmethod
    def try_parse(s: str) -> ?Decimal:
        parts = try_parse_float_parts(s)
        if parts is not None:
            _significand, _exponent = parts
            return Decimal(_significand, _exponent)
        return None

    @staticmethod
    def parse(s: str) -> Decimal:
        d = Decimal.try_parse(s)
        if d is not None:
            return d
        raise ValueError("Unable to parse as decimal: \"{s}\"")

    def try_lossless_realign(self, new_exponent: int) -> ?Decimal:
        exponent_diff = self.exponent - new_exponent
        if exponent_diff == 0:
            return self
        elif exponent_diff < 0:
            k = -exponent_diff
            if k > MAX_POW10:
                # Only zero survives a shift this large without losing digits
                return Decimal(0, new_exponent) if self.significand == 0 else None
            divider = 10**k
            if self.significand % divider == 0:
                return Decimal(self.significand // divider, new_exponent)
            else:
                return None # Would lose precision
        else: # alignment > 0:
            v = _mul_pow10(self.significand, exponent_diff)
            if v is None:
                return None # Outside the int range at the new exponent
            return Decimal(v!, new_exponent)

    def lossy_realign(self, new_exponent: int) -> Decimal:
        exponent_diff = self.exponent - new_exponent
        if exponent_diff == 0:
            return self
        elif exponent_diff < 0:
            return Decimal(_div_pow10(self.significand, -exponent_diff), new_exponent)
        else: # alignment > 0:
            v = _mul_pow10(self.significand, exponent_diff)
            if v is None:
                raise ValueError("{self} does not fit an int at exponent {new_exponent}")
            return Decimal(v!, new_exponent)

    def to_float(self) -> float:
        e = self.exponent
        if e >= 0:
            return float(self.significand) * 10.0**float(e)
        return float(self.significand) / 10.0**float(-e)

    def integral_part(self) -> int:
        e = self.exponent
        if e >= 0:
            v = _mul_pow10(self.significand, e)
            if v is None:
                raise ValueError("Integral part of {self} does not fit an int")
            return v!
        return _div_pow10(self.significand, -e)

    def fractional_part(self) -> Decimal:
        e = self.exponent
        if e >= 0:
            return Decimal(0, e)
        k = -e
        if k > MAX_POW10:
            return self # |significand| < 10**19, so all of it is fractional
        return Decimal(self.significand % 10**k, e)

    @staticmethod
    def decimal64_range(fraction_digits: int) -> (Decimal, Decimal):
        """The decimal64 value space for these fraction-digits

        RFC 7950 9.3.4: an int64 significand scaled by 10**-fraction-digits.
        """
        return (Decimal(MIN_INT, -fraction_digits), Decimal(MAX_INT, -fraction_digits))

    def canonical(self) -> (int, int):
        """The (significand, exponent) shared by all equal Decimals

        __eq__ realigns exponents, so the same value has many representations:
        3.14 is (314, -2) but also (3140, -3). Folding trailing zeros of the
        significand into the exponent picks one of them, which is what hash()
        needs. Zero is realigned to exponent 0, since Decimal(0, e) is equal for
        every e.
        """
        s = self.significand
        e = self.exponent
        if s == 0:
            return (s, 0)
        while s % 10 == 0:
            s //= 10
            e += 1
        return (s, e)

extension Decimal(Eq):
    def __eq__(self, other: Decimal) -> bool:
        exponent_diff = self.exponent - other.exponent
        if exponent_diff == 0:
            return self.significand == other.significand
        if exponent_diff > 0:
            v = _mul_pow10(self.significand, exponent_diff)
            # A realignment that leaves the int range cannot equal a significand
            # that is still inside it
            return v is not None and v! == other.significand
        v = _mul_pow10(other.significand, -exponent_diff)
        return v is not None and self.significand == v!


extension Decimal(Ord):
    def __lt__(self, other):
        exponent_diff = self.exponent - other.exponent
        if exponent_diff == 0:
            return self.significand < other.significand
        if exponent_diff > 0:
            v = _mul_pow10(self.significand, exponent_diff)
            if v is not None:
                return v! < other.significand
            # self realigns past the int range while other stays inside it, so
            # the sign of self decides
            return self.significand < 0
        v = _mul_pow10(other.significand, -exponent_diff)
        if v is not None:
            return self.significand < v!
        return other.significand > 0


extension Decimal(Hashable):
    def hash(self, h):
        s, e = self.canonical()
        s.hash(h)
        e.hash(h)

# -------------------------------------------------------------------------------

class Ranges[T(Ord)](object):
    @property
    ranges: list[(T, T)] # Inclusive ranges!

    def __init__(self, ranges: list[(T, T)]):
        self.ranges = ranges

    def __str__(self):
        ranges = []
        for r in self.ranges:
            # https://github.com/actonlang/acton/issues/2533
            # r_str = str(r.0) if r.0 == r.1 else "{str(r.0)}..{str(r.1)}" # Crashes
            # <workaround>
            r0: T = r.0
            r1: T = r.1
            if isinstance(r0, int) and isinstance(r1, int):
                r_str = str(r0) if r0 == r1 else "{str(r0)}..{str(r1)}"
            elif isinstance(r0, u64) and isinstance(r1, u64):
                r_str = str(r0) if r0 == r1 else "{str(r0)}..{str(r1)}"
            elif isinstance(r0, Decimal) and isinstance(r1, Decimal):
                r_str = str(r0) if r0 == r1 else "{str(r0)}..{str(r1)}"
            else:
                raise NotImplementedError("{type(r0)} {type(r1)}")
            # </workaround>
            # Pending https://github.com/actonlang/acton/issues/1125
            # ranges.append(r_str)
            ranges += [r_str]
        return " | ".join(ranges)


    def __repr__(self):
        # return "Ranges({repr(self.ranges)})"
        # Workaround https://github.com/actonlang/acton/issues/2545
        ranges = []
        for r in self.ranges:
            r_repr = "({repr(r.0)}, {repr(r.1)})"
            # Pending https://github.com/actonlang/acton/issues/1125
            # ranges.append(r_repr)
            ranges += [r_repr]
        return "Ranges([{", ".join(ranges)}])"

    def match(self, val) -> bool:
        # return self._search_index(val, div) is not None
        # Workaround https://github.com/actonlang/acton/issues/1448 & https://github.com/actonlang/acton/issues/2483
        return True if Ranges._search_index(self, val) is not None else False

    def _search_index(self, val, begin_i=0, div=10) -> ?int:
        range_len = len(self.ranges)
        end_i = range_len
        while True:
            span_len = (end_i - begin_i) // div
            if span_len == 0:
                span_len = 1
            span_i = begin_i
            while span_i < end_i:
                next_span_i = span_i + span_len
                if next_span_i > end_i:
                    next_span_i = end_i
                if val >= self.ranges[span_i].0 and val <= self.ranges[next_span_i - 1].1:
                    if span_len == 1:
                        return span_i
                    else:
                        begin_i = span_i
                        end_i = next_span_i
                        break
                span_i = next_span_i
            if span_i >= range_len:
                break
        return None

class RangesBuilder[T(Ord)](Ranges[T]):
    def __init__(self, ranges: list[(T, T)] = []):
        self.ranges = ranges

    @staticmethod
    def from_ranges(r: Ranges[T]) -> RangesBuilder[T]:
        return RangesBuilder(list(r.ranges))

    def append_value(self, v: T):
        RangesBuilder.append_range(self, v, v)

    def append_range(self, l: T, u: T):
        if l > u:
            raise ValueError("Appended ranges must be specified as (min, max)")
        if len(self.ranges) >= 1 and self.ranges[-1].1 >= l:
            raise ValueError("Appended ranges must be disjoint and in ascending order")
        self.ranges.append((l, u))

    def append_value_restriction_of(self, v: T, other: Ranges[T]):
        RangesBuilder.append_range_restriction_of(self, v, v, other)

    def append_range_restriction_of(self, l: ?T, u: ?T, other: Ranges[T]):
        if other.ranges:
            _l = l if l is not None else other.ranges[0].0
            _u = u if u is not None else other.ranges[-1].1

            i = Ranges._search_index(other, _l)
            if i is not None and _u <= other.ranges[i].1:
                RangesBuilder.append_range(self, _l, _u)
                return
        elif l is None and u is None:
            return # Empty base but no further restriction!
        raise ValueError("Restriction must be a subset of existing range {str(other)}")

    def into_ranges(self) -> Ranges[T]:
        r = Ranges(self.ranges)
        self.ranges = []
        return r

# -------------------------------------------------------------------------------

def try_parse_float_parts(s: str) -> ?(int, int):
    s = s.strip(" \t\n")

    p = s.split('e', -1)
    plen = len(p)
    exp: int = 0
    if plen == 2:
        try:
            exp = int(p[1])
        except ValueError:
            return None
        if exp > MAX_EXPONENT or exp < -MAX_EXPONENT:
            return None
    elif plen != 1:
        return None

    f = p[0].split(".", -1)
    flen = len(f)

    significand: int = 0

    if flen == 1:
        try:
            significand = int(f[0])
        except ValueError:
            return None
    elif flen == 2:
        ip = f[0]
        fp = f[1]
        if not fp.isdecimal():
            return None
        try:
            significand = int(ip + fp)
        except ValueError:
            return None
        exp -= len(fp)
    else:
        return None

    return (significand, exp)

# -------------------------------------------------------------------------------

def _test_decimal():
    testing.assertEqual(Decimal.parse("42"), Decimal(42, 0))
    testing.assertEqual(Decimal.parse("3.14"), Decimal(314, -2))
    testing.assertEqual(Decimal(314, -2), Decimal.parse("3.14"))
    testing.assertEqual(Decimal(3140, -3), Decimal(314, -2))
    testing.assertEqual(Decimal(314, -2), Decimal(3140, -3))
    testing.assertEqual(Decimal(314, -2).integral_part(), 3)
    testing.assertEqual(Decimal(314, -2).fractional_part(), Decimal(14, -2))

    testing.assertEqual(str(Decimal.parse("3.14")), "3.14")
    testing.assertEqual(str(Decimal.parse("1.001")), "1.001")

    testing.assertTrue(Decimal.parse("3.14") > Decimal.parse("3.139"))

    testing.assertTrue(Decimal.parse("55.7") > Decimal.parse("-92233720368547758.08"))
    testing.assertTrue(Decimal.parse("55.7") < Decimal.parse("92233720368547758.07"))

def _test_decimal_hash_eq():
    """Equal Decimals must hash equally, whatever scale they are written at"""
    equal_pairs = [
        (Decimal(1, 0), Decimal(10, -1)),               # 1 == 1.0
        (Decimal(-1, 0), Decimal(-10, -1)),             # -1 == -1.0
        (Decimal(314, -2), Decimal(3140, -3)),          # 3.14
        (Decimal(0, 5), Decimal(0, -3)),                # zero at any exponent
        (Decimal(42, 0), Decimal(42000, -3)),
        (Decimal(5, 1), Decimal(50, 0)),                # 50, no fraction at all
        (Decimal.parse("3.14"), Decimal.parse("3.140")),
    ]
    for a, b in equal_pairs:
        testing.assertEqual(a, b)
        testing.assertEqual(hash(a), hash(b))
        # A Decimal is its own key, so dict lookups cross scales too
        testing.assertEqual({a: "v"}.get(b), "v")

    # Unequal Decimals are still told apart, which hashing alone does not do
    testing.assertNotEqual(Decimal(1, 0), Decimal(10, 0))
    testing.assertNotEqual(Decimal(1, 0), Decimal(1, -1))
    # Colliding hashes are legal, so __eq__ has to keep unequal values apart
    # on its own.
    d = {Decimal(1, 0): "pos", Decimal(-1, 0): "neg"}
    testing.assertEqual(len(d), 2)
    testing.assertEqual(d.get(Decimal(10, -1)), "pos")
    testing.assertEqual(d.get(Decimal(-10, -1)), "neg")

def _test_decimal_positive_exponent():
    """A positive exponent scales the value up; it is not ignored"""
    testing.assertEqual(Decimal(5, 1).integral_part(), 50)
    testing.assertEqual(Decimal(42, 0).integral_part(), 42)
    testing.assertEqual(Decimal(314, -2).integral_part(), 3)
    testing.assertEqual(str(Decimal(5, 1)), "50")
    testing.assertEqual(Decimal(5, 1).to_float(), 50.0)
    testing.assertEqual(Decimal(314, -2).to_float(), 3.14)
    testing.assertEqual(Decimal(42, 0).to_float(), 42.0)

def _test_decimal_str():
    """Formatting, including the negatives that integral/fractional splitting broke"""
    testing.assertEqual(str(Decimal(314, -2)), "3.14")
    testing.assertEqual(str(Decimal(-314, -2)), "-3.14")
    testing.assertEqual(str(Decimal(1001, -3)), "1.001")
    testing.assertEqual(str(Decimal(-1001, -3)), "-1.001")
    testing.assertEqual(str(Decimal(-1, -2)), "-0.01")
    testing.assertEqual(str(Decimal(0, -2)), "0.00")
    testing.assertEqual(str(Decimal(42, 0)), "42")
    testing.assertEqual(str(Decimal(-42, 0)), "-42")
    testing.assertEqual(str(Decimal(5, 1)), "50")
    testing.assertEqual(str(Decimal(MIN_INT, -2)), "-92233720368547758.08")
    testing.assertEqual(str(Decimal(MAX_INT, -2)), "92233720368547758.07")

def _test_decimal_repr_roundtrip():
    """repr must stay writable as Acton source, MIN_INT included"""
    testing.assertEqual(repr(Decimal(314, -2)), "Decimal(314, -2)")
    testing.assertEqual(repr(Decimal(MIN_INT, -2)), "Decimal(-9223372036854775807 - 1, -2)")

def _test_decimal_compare_past_int_range():
    """Realigning to compare can leave the int range; the result must still be right

    Both of these are legal decimal64: 9.223372036854775807 has fraction-digits
    18 with the significand at the int64 limit, 9.5 has fraction-digits 1.
    Comparing them realigns 95 by 10**17 = 9.5e18, past the int64 maximum.
    """
    a = Decimal(MAX_INT, -18)   # 9.223372036854775807
    b = Decimal(95, -1)         # 9.5
    testing.assertTrue(a < b)
    testing.assertFalse(b < a)
    testing.assertNotEqual(a, b)

    # ... and the same on the negative side
    na = Decimal(MIN_INT, -18)
    nb = Decimal(-95, -1)
    testing.assertTrue(nb < na)
    testing.assertFalse(na < nb)
    testing.assertNotEqual(na, nb)

    # A shift far past any int stays consistent both ways
    huge = Decimal(7, 100)
    testing.assertTrue(b < huge)
    testing.assertFalse(huge < b)
    testing.assertNotEqual(huge, b)

def _test_decimal_parse_out_of_range():
    """int cannot hold what falls outside the decimal64 value space"""
    # One past the decimal64 minimum for fraction-digits 2
    testing.assertNone(Decimal.try_parse("-92233720368547758.09"))
    testing.assertNone(Decimal.try_parse("99999999999999999999"))
    testing.assertNone(Decimal.try_parse("1e99999999999999999999"))
    testing.assertNone(Decimal.try_parse("1e100000"))
    # The bounds themselves still parse
    testing.assertEqual(Decimal.parse("-92233720368547758.08"), Decimal(MIN_INT, -2))
    testing.assertEqual(Decimal.parse("92233720368547758.07"), Decimal(MAX_INT, -2))

def _test_decimal_parts():
    """integral_part/fractional_part follow the truncating division of int"""
    testing.assertEqual(Decimal(314, -2).integral_part(), 3)
    testing.assertEqual(Decimal(-314, -2).integral_part(), -3)
    testing.assertEqual(Decimal(314, -2).fractional_part(), Decimal(14, -2))
    testing.assertEqual(Decimal(-314, -2).fractional_part(), Decimal(-14, -2))
    testing.assertEqual(Decimal(5, 1).integral_part(), 50)
    testing.assertEqual(Decimal(42, 0).integral_part(), 42)
    testing.assertEqual(Decimal(5, 1).to_float(), 50.0)
    testing.assertEqual(Decimal(314, -2).to_float(), 3.14)

def _test_decimal64_range():
    lo, hi = Decimal.decimal64_range(2)
    testing.assertEqual(lo, Decimal(MIN_INT, -2))
    testing.assertEqual(hi, Decimal(MAX_INT, -2))
    testing.assertTrue(Ranges.match(Ranges([Decimal.decimal64_range(2)]), Decimal(557, -1)))

def _test_decimal_realign():
    testing.assertEqual(Decimal(314, -2).try_lossless_realign(-3), Decimal(3140, -3))
    testing.assertNone(Decimal(314, -2).try_lossless_realign(-1))
    # 9.3 has no decimal64 form at fraction-digits 18: 93 * 10**17 leaves the range
    testing.assertNone(Decimal(93, -1).try_lossless_realign(-18))
    # ... while 9.0 does
    testing.assertEqual(Decimal(90, -1).try_lossless_realign(-18), Decimal(9000000000000000000, -18))

def _test_decimal_fail():
    try:
        Decimal.parse("foo")
    except:
        pass
    else:
        testing.error("Expected exception")

    testing.assertNone(Decimal.try_parse("foo"))

def _test_ranges_int():
    testing.assertTrue(Ranges.match(Ranges([(1, 2)]), 1))
    testing.assertTrue(Ranges.match(Ranges([(1, 2)]), 2))
    testing.assertFalse(Ranges.match(Ranges([(1, 2)]), 0))
    testing.assertFalse(Ranges.match(Ranges([(1, 2)]), 3))
    testing.assertFalse(Ranges.match(Ranges([(1, 10)]), 100))
    testing.assertFalse(Ranges.match(Ranges([(1, 10)]), 101))

def _test_ranges_decimal():
    testing.assertTrue(Ranges.match(Ranges([(Decimal.parse("1.1"), Decimal.parse("1.3"))]), Decimal.parse("1.1")))
    testing.assertTrue(Ranges.match(Ranges([(Decimal.parse("1.1"), Decimal.parse("1.3"))]), Decimal.parse("1.2")))
    testing.assertTrue(Ranges.match(Ranges([(Decimal.parse("1.1"), Decimal.parse("1.3"))]), Decimal.parse("1.3")))
    testing.assertTrue(Ranges.match(Ranges([(Decimal.parse("-92233720368547758.08"), Decimal.parse("92233720368547758.07"))]), Decimal.parse("55.7")))
    testing.assertFalse(Ranges.match(Ranges([(Decimal.parse("1.1"), Decimal.parse("1.3"))]), Decimal.parse("1.099999")))
    testing.assertFalse(Ranges.match(Ranges([(Decimal.parse("1.1"), Decimal.parse("1.3"))]), Decimal.parse("1.300001")))

def _test_ranges_builder():
    rb1 = RangesBuilder()
    RangesBuilder.append_range(rb1, 0, 15)
    for i in range(0, 16):
        testing.assertTrue(RangesBuilder.match(rb1, i))

    rb2 = RangesBuilder()
    RangesBuilder.append_value_restriction_of(rb2, 7, rb1)
    for i in range(0, 7):
        testing.assertFalse(RangesBuilder.match(rb2, i))
    testing.assertTrue(RangesBuilder.match(rb2, 7))
    for i in range(8, 15):
        testing.assertFalse(RangesBuilder.match(rb2, i))

def _test_ranges_builder_min():
    rb1 = RangesBuilder()
    RangesBuilder.append_range(rb1, 0, 15)

    rb2 = RangesBuilder()
    RangesBuilder.append_range_restriction_of(rb2, None, 13, rb1)
    for i in range(0, 14):
        testing.assertTrue(RangesBuilder.match(rb2, i))
    for i in range(14, 15):
        testing.assertFalse(RangesBuilder.match(rb2, i))

def _test_ranges_builder_max():
    rb1 = RangesBuilder()
    RangesBuilder.append_range(rb1, 0, 15)

    rb2 = RangesBuilder()
    RangesBuilder.append_range_restriction_of(rb2, 4, None, rb1)
    for i in range(0, 3):
        testing.assertFalse(RangesBuilder.match(rb2, i))
    for i in range(4, 15):
        testing.assertTrue(RangesBuilder.match(rb2, i))

def _assert_append_range_error(rb: RangesBuilder[int], l: int, u: int, expected: str):
    try:
        RangesBuilder.append_range(rb, l, u)
    except ValueError as ex:
        testing.assertEqual(expected, ex.error_message, "Unexpected error appending ({l}, {u})")
        return
    testing.error("Expected ValueError appending ({l}, {u})")

def _assert_restriction_error(rb: RangesBuilder[int], l: ?int, u: ?int, base: Ranges[int], expected: str):
    try:
        RangesBuilder.append_range_restriction_of(rb, l, u, base)
    except ValueError as ex:
        testing.assertEqual(expected, ex.error_message, "Unexpected error restricting to ({l}, {u})")
        return
    testing.error("Expected ValueError restricting to ({l}, {u})")

def _test_ranges_builder_error():
    inverted = "Appended ranges must be specified as (min, max)"
    unordered = "Appended ranges must be disjoint and in ascending order"

    rb = RangesBuilder()
    # An inverted range, before anything has been appended
    _assert_append_range_error(rb, 5, 1, inverted)

    RangesBuilder.append_range(rb, 0, 15)
    # Overlapping, touching at the bound, and preceding the previous range
    _assert_append_range_error(rb, 10, 20, unordered)
    _assert_append_range_error(rb, 15, 20, unordered)
    _assert_append_range_error(rb, 0, 5, unordered)
    # A single value inside the range already appended
    try:
        RangesBuilder.append_value(rb, 7)
        testing.error("Expected ValueError appending the value 7")
    except ValueError as ex:
        testing.assertEqual(unordered, ex.error_message, "Unexpected error appending the value 7")

    # Restrictions are checked against the base, in either boundary
    base = Ranges([(0, 15), (19, 42)])
    rb2: RangesBuilder[int] = RangesBuilder()
    _assert_restriction_error(rb2, 10, 20, base, "Restriction must be a subset of existing range 0..15 | 19..42")
    _assert_restriction_error(rb2, 43, None, base, "Restriction must be a subset of existing range 0..15 | 19..42")
    _assert_restriction_error(rb2, 16, 18, base, "Restriction must be a subset of existing range 0..15 | 19..42")

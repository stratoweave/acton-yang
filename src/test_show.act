"""Show policies for concrete, generic, and parent-typed YANG objects."""

import testing
import gdata
import schema
import xpath
import adata
from identityref import Identityref
from type import Decimal, Ranges


def _render[A(Show)](item: A) -> (str, str):
    return str(item), repr(item)


def _test_concrete_and_generic():
    testing.assertEqual(_render(Decimal(314, -2)), ("3.14", "Decimal(314, -2)"))
    testing.assertEqual(_render(Ranges([(1, 3), (7, 7)])),
                        ("1..3 | 7", "Ranges([(1, 3), (7, 7)])"))
    reference = Identityref("one", "urn:test", "test", "t")
    testing.assertEqual(_render(reference),
        (r"Identityref('one', ns='urn:test', mod='test', pfx='t')",
         r"Identityref('one', ns='urn:test', mod='test', pfx='t')"))


def _test_atom_view():
    number: atom = Decimal(314, -2)
    testing.assertEqual(str(number), "3.14")
    testing.assertEqual(repr(number), "Decimal(314, -2)")
    values: list[atom] = [42, u64(7), True, "x", b"y", Decimal(314, -2)]
    testing.assertEqual(repr(values), r"[42, 7, True, 'x', b'y', Decimal(314, -2)]")


def _test_parent_views():
    node: gdata.Node = gdata.Leaf("x")
    testing.assertEqual(repr(node), r"Leaf('x')")
    entry: gdata.LeafListEntry = gdata.LeafListEntryReplace(u64(7))
    testing.assertEqual(repr(entry), "LeafListEntryReplace(u64(7))")
    match: gdata.ValueMatch = gdata.VWildcard("prefix*")
    testing.assertEqual(repr(match), r"VWildcard('prefix*')")
    filter_node = gdata.FNode(value_match=match)
    testing.assertEqual(repr(filter_node), r"FNode(VWildcard('prefix*'))")
    stmt: schema.SchemaNode = schema.Container("c")
    testing.assertEqual(str(stmt), "Container c")


def _test_xpath_parent_views():
    first: xpath.Step = xpath.NodeTestStep("t", "leaf", [])
    last: xpath.Step = xpath.AbbreviatedStep("..")
    path: xpath.LocationPath = xpath.AbsoluteLocationPath([first, last])
    testing.assertEqual(str(first), "t:leaf")
    testing.assertEqual(str(last), "..")
    testing.assertEqual(str(path), "/t:leaf/..")
    testing.assertTrue(repr(first).endswith("NodeTestStep('t', 'leaf', [])"))
    testing.assertTrue("AbbreviatedStep('..')" in repr(path))


def _test_erased_leaf_values():
    testing.assertEqual(gdata.yang_str(Decimal(314, -2)), "3.14")
    testing.assertEqual(gdata.yang_str(42), "42")
    testing.assertEqual(gdata.yang_str(2.5), "2.5")
    testing.assertEqual(gdata.yang_str(True), "true")
    testing.assertEqual(gdata.key_str_part(42), "42")
    testing.assertEqual(gdata.repr_gdata(["x", Decimal(314, -2), gdata.Present()]),
                        r"['x', Decimal(314, -2), Present()]")


class KeyedEntry(adata.MNode):
    def __init__(self, key: str):
        self.key = key


def _test_generic_key_diagnostics():
    entries = adata.MKeyedList(lambda entry: entry.key, [KeyedEntry("one")])
    try:
        ignored = entries["missing"]
        testing.error("Expected a missing-key error")
    except KeyError as error:
        testing.assertTrue("key: missing" in str(error))
    try:
        entries["two"] = KeyedEntry("three")
        testing.error("Expected a mismatched-key error")
    except ValueError as error:
        testing.assertEqual(error.error_message,
            "cannot assign entry keyed three at key two; delete and re-create to change a key")

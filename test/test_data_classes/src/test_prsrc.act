def _test_prsrc_yang_one_compiled_roundtrip():
    """Test compiled schema prsrc() consistency after restoring the schema from data structure

    We restore the compiled schema tree which is a DRoot tree and stored as an
    auxiliary data structu in the adata module. Then we compare the restored
    schema tree with a newly compiled schema tree directly from YANG (also
    grabbed the adata module).
    """
    schema_1 = yang.compile([y.src for y in yang_one.src_yang()])
    schema_2 = yang_one.SRC_DNODE
    # TODO: Compare the DNode objects for equality using the Eq extension
    #testing.assertEqual(schema_1, schema_2)
    # Compare the output of prsrc() to ensure we can do it again
    testing.assertEqual(schema_1.prsrc(), schema_2.prsrc())


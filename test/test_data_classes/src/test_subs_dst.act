import testing
import std.xml as xml
import yang.gdata as gdata
import yang_filter_test_oper as ft_oper


def _sample_tree() -> gdata.Node:
    data = ft_oper.root(
        system_state=ft_oper.filter_test__system_state(
            clock=ft_oper.filter_test__system_state__clock(
                current_datetime="2026-04-21T10:15:00Z",
                boot_datetime="2026-04-01T00:00:00Z",
            ),
        ),
        interfaces=ft_oper.filter_test__interfaces(),
    )

    eth0 = data.interfaces.interface.create(
        "eth0",
        description="Uplink",
        type="ethernetCsmacd",
        enabled=True,
        admin_status="up",
        oper_status="up",
        last_change="2026-04-20T12:00:00Z",
    )
    eth0.statistics.in_octets = u64(1234)
    eth0.statistics.out_octets = u64(5678)
    eth0.ipv4.mtu = u64(1500)
    eth0.ipv6.mtu = u64(1500)
    eth0.address.create("10.0.0.1", prefix_length=u64(24))

    eth1 = data.interfaces.interface.create(
        "eth1",
        description="Server",
        type="ethernetCsmacd",
        enabled=False,
        admin_status="down",
        oper_status="lower-layer-down",
        last_change="2026-04-19T07:30:00Z",
    )
    eth1.statistics.in_octets = u64(42)
    eth1.statistics.out_octets = u64(84)
    eth1.ipv4.mtu = u64(9000)
    eth1.ipv6.mtu = u64(9000)
    eth1.address.create("10.0.0.2", prefix_length=u64(25))

    return data.to_gdata()


def _merged_filter(want: set[gdata.SubscriptionSpec]) -> ?gdata.FNode:
    top_children: list[gdata.FNode] = []
    for spec in want:
        filt = spec.filt
        if filt is not None:
            if filt.name is not None:
                top_children.append(filt)
            else:
                top_children.extend(filt.children)
    if len(top_children) == 0:
        return None
    return gdata.FNode(children=gdata.filter_merge_list(top_children))


class MockSubscriptionTreeProvider(gdata.TreeProvider):
    @property
    on_declared: action() -> None
    declared: dict[str, set[gdata.SubscriptionSpec]]
    callbacks: dict[str, proc(?gdata.Node, ?Exception) -> None]
    synced: dict[str, action(str) -> None]

    def __init__(self, on_declared: action() -> None):
        self.on_declared = on_declared
        self.declared = {}
        self.callbacks = {}
        self.synced = {}

    proc def rpc(self, cb: action(?gdata.Node, ?Exception) -> None, rpc: gdata.Node):
        cb(None, ValueError("rpc is not used in this test"))

    proc def declare_subscriptions(self, owner_id: str, cb: proc(?gdata.Node, ?Exception) -> None, want: set[gdata.SubscriptionSpec], synced: ?action(str) -> None):
        self.declared[owner_id] = want
        self.callbacks[owner_id] = cb
        if synced is not None:
            self.synced[owner_id] = synced
        self.on_declared()

    proc def remove_subscriptions(self, owner_id: str):
        if owner_id in self.declared:
            del self.declared[owner_id]
        if owner_id in self.callbacks:
            del self.callbacks[owner_id]

    def deliver_all(self, data: gdata.Node):
        """One tree per owner; an owner rooted at a node gets one instance at
        a time, as a spine from the top, then synced, as a layer delivers."""
        for owner_id in [owner_id for owner_id in self.callbacks]:
            filt = _merged_filter(self.declared[owner_id])
            tree = gdata.filter(data, filt) if filt is not None else data
            root: ?gdata.FNode = None
            for spec in self.declared[owner_id]:
                root = spec.root
            names = gdata.root_names(root)
            if len(names) > 0:
                for i in gdata.instances(tree, names):
                    self.callbacks[owner_id](i.1, None)
            else:
                self.callbacks[owner_id](tree, None)
            if owner_id in self.synced:
                self.synced[owner_id](owner_id)

    def deliver_gone(self, owner_id: str, key: str):
        """The instance with this key, as a layer reports it gone."""
        root: ?gdata.FNode = None
        for spec in self.declared[owner_id]:
            root = spec.root
        names = gdata.root_names(root)
        for i in gdata.instances(_sample_tree(), names):
            if i.0 == key:
                self.callbacks[owner_id](gdata.gone(i.1, names), None)


actor _test_subs_dst_grouping(t: testing.AsyncT):
    var declared = 0
    var state_root: ?ft_oper.root = None
    var state_err: ?Exception = None
    var links_root: ?ft_oper.root = None
    var links_err: ?Exception = None
    var tp: ?MockSubscriptionTreeProvider = None

    def finish_if_ready():
        if state_root is None or links_root is None:
            return

        if state_err is not None:
            t.failure(state_err)
            return
        if links_err is not None:
            t.failure(links_err)
            return

        state = state_root!
        links = links_root!

        testing.assertEqual(state.system_state.clock.current_datetime, "2026-04-21T10:15:00Z")
        testing.assertEqual(state.system_state.clock.boot_datetime, "2026-04-01T00:00:00Z")

        state_ifaces = [iface for iface in state.interfaces.interface]
        testing.assertEqual(len(state_ifaces), 1)
        testing.assertEqual(state_ifaces[0].name, "eth0")
        testing.assertEqual(state_ifaces[0].statistics.in_octets, u64(1234))
        testing.assertEqual(state_ifaces[0].statistics.out_octets, u64(5678))
        testing.assertEqual(state_ifaces[0].oper_status, None)
        testing.assertEqual(state_ifaces[0].ipv4.mtu, None)

        testing.assertEqual(links.system_state.clock.current_datetime, None)
        links_ifaces = [iface for iface in links.interfaces.interface]
        testing.assertEqual(len(links_ifaces), 2)
        testing.assertEqual(links_ifaces[0].name, "eth0")
        testing.assertEqual(links_ifaces[0].oper_status, "up")
        testing.assertEqual(links_ifaces[1].name, "eth1")
        testing.assertEqual(links_ifaces[1].oper_status, "lower-layer-down")
        testing.assertEqual(links_ifaces[0].statistics.in_octets, None)

        t.success()

    def on_state(root: ?ft_oper.root, err: ?Exception):
        state_root = root
        state_err = err
        finish_if_ready()

    def on_links(root: ?ft_oper.root, err: ?Exception):
        links_root = root
        links_err = err
        finish_if_ready()

    def on_declared():
        if tp is None:
            t.failure(ValueError("MockSubscriptionTreeProvider not initialized"))
            return
        actual_tp = tp!
        declared += 1
        if declared != 2:
            return

        testing.assertEqual(len(actual_tp.declared), 2)
        testing.assertEqual(sorted([len(actual_tp.declared[owner_id]) for owner_id in actual_tp.declared]), [1, 2])
        actual_tp.deliver_all(_sample_tree())

    tp = MockSubscriptionTreeProvider(on_declared)
    subs = gdata.SubscriptionManager(tp!, "test-owner")

    state_dst = ft_oper.dst(on_state)
    links_dst = ft_oper.dst(on_links)
    sub = ft_oper.subs
    iface = sub.interfaces.interface.entry("eth0")

    want = {
        state_dst.deliver({
            sub.system_state.clock.subscribe(depth=1, period=0.05),
            iface.subscribe(select=[iface.statistics], period=1.0),
        }),
        links_dst.deliver({
            sub.interfaces.interface.oper_status.subscribe(period=1.0),
        }),
    }

    subs.declare(want)


actor _test_subs_dst_rooted_at_list(t: testing.AsyncT):
    """A destination rooted at a list gets one typed entry per delivery,
    keyed first, None for an entry that is gone, and synced after the first
    pass."""
    var got: list[str] = []
    var synced = False
    var tp: ?MockSubscriptionTreeProvider = None

    def on_iface(keys, iface, err):
        if keys is not None:
            if iface is not None:
                status = iface.oper_status
                got.append(keys.interface_name + "=" + (status if status is not None else "?"))
            else:
                got.append(keys.interface_name + " gone")
                testing.assertEqual(got, ["eth0=up", "eth1=lower-layer-down", "eth1 gone"])
                t.success()

    def on_synced():
        synced = True
        testing.assertEqual(len(got), 2)
        it = next(iter(tp!.callbacks.keys()))
        if isinstance(it,just):
            tp!.deliver_gone(it.val, "eth1")

    def on_declared():
        actual_tp = tp!
        for want in actual_tp.declared.values():
            for spec in want:
                names = gdata.root_names(spec.root)
                testing.assertEqual([n.name for n in names], ["interfaces", "interface"])
        actual_tp.deliver_all(_sample_tree())

    tp = MockSubscriptionTreeProvider(on_declared)
    subs = gdata.SubscriptionManager(tp!, "test-owner")
    ifaces = ft_oper.subs.interfaces.interface
    subs.declare({
        ifaces.dst(on_iface).deliver({ifaces.oper_status.subscribe(period=1.0)}),
    }, synced=on_synced)


actor _test_subs_dst_rooted_at_container(t: testing.AsyncT):
    """A destination rooted at a container gets that container, typed."""
    var tp: ?MockSubscriptionTreeProvider = None

    def on_clock(clock, err):
        testing.assertEqual(clock!.current_datetime, "2026-04-21T10:15:00Z")
        t.success()

    def on_declared():
        tp!.deliver_all(_sample_tree())

    tp = MockSubscriptionTreeProvider(on_declared)
    subs = gdata.SubscriptionManager(tp!, "test-owner")
    clock = ft_oper.subs.system_state.clock
    subs.declare({clock.dst(on_clock).deliver({clock.subscribe(period=1.0)})})


def _test_rooted_specs_are_distinct():
    """The root is part of a spec's identity, so two destinations with the
    same filters but different roots are declared apart."""
    ifaces = ft_oper.subs.interfaces.interface
    want = {ifaces.oper_status.subscribe(period=1.0)}
    top = ft_oper.dst(lambda r, e: None).deliver(want)
    rooted = ifaces.dst(lambda k, i, e: None).deliver(want)
    testing.assertTrue(top != rooted)
    testing.assertEqual(len({top, rooted}), 2)
    for spec in rooted.want:
        testing.assertEqual([n.name for n in gdata.root_names(spec.root)], ["interfaces", "interface"])


actor _test_subs_dst_container_gone_is_none(t: testing.AsyncT):
    """A destination rooted at a container hears None when the container is gone."""
    var tp: ?MockSubscriptionTreeProvider = None
    var seen = 0

    def on_clock(clock, err):
        seen += 1
        if seen == 1:
            testing.assertEqual(clock!.current_datetime, "2026-04-21T10:15:00Z")
            it = next(iter(tp!.callbacks.keys()))
            if isinstance(it,just):
                tp!.deliver_gone(it.val, "")
        elif clock is None:
            t.success()
        else:
            t.failure(ValueError("expected None for the gone container"))

    def on_declared():
        tp!.deliver_all(_sample_tree())

    tp = MockSubscriptionTreeProvider(on_declared)
    subs = gdata.SubscriptionManager(tp!, "test-owner")
    clock = ft_oper.subs.system_state.clock
    subs.declare({clock.dst(on_clock).deliver({clock.subscribe(period=1.0)})})


def _test_rooted_filters_must_lead_to_the_root():
    """A filter handed to a rooted destination starts at its root, or ends
    above it; anything else is refused when the delivery is built."""
    sub = ft_oper.subs
    ifaces = sub.interfaces.interface
    dst = ifaces.dst(lambda k, i, e: None)
    dst.deliver({ifaces.oper_status.subscribe(period=1.0)})
    dst.deliver({ifaces.entry("eth0").subscribe(period=1.0)})
    dst.deliver({sub.interfaces.subscribe(period=1.0)})
    dst.deliver({gdata.SubscriptionSpec(None, period=1.0)})
    try:
        dst.deliver({sub.system_state.clock.subscribe(period=1.0)})
    except ValueError:
        pass
    else:
        raise ValueError("a filter beside the root was accepted")


def _test_root_must_name_a_node():
    """A root that names nothing is not the top of the tree in disguise."""
    testing.assertEqual(len(gdata.root_names(None)), 0)
    try:
        gdata.root_names(gdata.FNode())
    except ValueError:
        pass
    else:
        raise ValueError("a nameless root was accepted")


actor _test_subs_dst_rooted_below_a_list(t: testing.AsyncT):
    """Rooted at a list below another list: every delivery carries the keys
    of both lists, then the instance."""
    var got: list[str] = []
    var tp: ?MockSubscriptionTreeProvider = None

    def on_address(keys, address, err):
        if keys is not None:
            if address is not None:
                got.append(keys.interface_name + " " + keys.address_ip + " /" + str(address.prefix_length))
            else:
                got.append(keys.interface_name + " " + keys.address_ip + " gone")
                testing.assertEqual(sorted(got), ["eth0 10.0.0.1 /24", "eth1 10.0.0.2 /25", "eth1 10.0.0.2 gone"])
                t.success()

    def on_synced():
        testing.assertEqual(len(got), 2)
        it = next(iter(tp!.callbacks.keys()))
        if isinstance(it,just):
            tp!.deliver_gone(it.val, "eth1/10.0.0.2")

    def on_declared():
        tp!.deliver_all(_sample_tree())

    tp = MockSubscriptionTreeProvider(on_declared)
    subs = gdata.SubscriptionManager(tp!, "test-owner")
    addresses = ft_oper.subs.interfaces.interface.address
    subs.declare({addresses.dst(on_address).deliver({addresses.subscribe(period=1.0)})}, synced=on_synced)


def _test_spines_and_gone():
    """An instance's spine holds the path from the top down to it alone, and
    gone keeps the keys of every list on the way."""
    names = [gdata.Id("http://example.com/filter-test", "interfaces"), gdata.Id("http://example.com/filter-test", "interface"), gdata.Id("http://example.com/filter-test", "address")]
    found = gdata.instances(_sample_tree(), names)
    testing.assertEqual(sorted([i.0 for i in found]), ["eth0/10.0.0.1", "eth1/10.0.0.2"])
    for i in found:
        spine = i.1
        ifaces = spine.children[names[0]].children[names[1]]
        testing.assertTrue(isinstance(ifaces, gdata.List))
        if isinstance(ifaces, gdata.List):
            testing.assertEqual(len(ifaces.elements), 1)
            entry = ifaces.elements[0]
            testing.assertEqual(sorted([k.name for k in entry.children.keys()]), ["address", "name"])
        g = gdata.gone(spine, names)!
        addr = g.children[names[0]].children[names[1]]
        if isinstance(addr, gdata.List):
            inner = addr.elements[0].children[names[2]]
            if isinstance(inner, gdata.List):
                testing.assertTrue(isinstance(inner.elements[0], gdata.Absent))


actor _test_synced_covers_the_whole_declaration(t: testing.AsyncT):
    """A declaration's synced fires once, after every delivery in it has had
    its first pass, and not again for a declaration that adds nothing."""
    var got = 0
    var synced = 0
    var delivered = False
    var tp: ?MockSubscriptionTreeProvider = None
    var subs: ?gdata.SubscriptionManager = None

    def on_state(root: ?ft_oper.root, err: ?Exception):
        got += 1

    def on_iface(keys, iface, err):
        got += 1

    def on_synced():
        synced += 1
        testing.assertEqual(got, 3)              # the state tree and two interfaces
        declare(on_synced_again)                 # the same set: nothing new to wait for

    def on_synced_again():
        testing.assertEqual(synced, 1)
        testing.assertEqual(got, 3)              # nothing was delivered again
        t.success()

    def on_declared():
        if len(tp!.declared) == 2 and not delivered:
            delivered = True                     # a layer delivers a first pass once
            tp!.deliver_all(_sample_tree())

    def declare(on_all: action() -> None):
        ifaces = ft_oper.subs.interfaces.interface
        subs!.declare({
            ft_oper.dst(on_state).deliver({ft_oper.subs.system_state.clock.subscribe(period=1.0)}),
            ifaces.dst(on_iface).deliver({ifaces.oper_status.subscribe(period=1.0)}),
        }, synced=on_all)

    tp = MockSubscriptionTreeProvider(on_declared)
    subs = gdata.SubscriptionManager(tp!, "test-owner")
    declare(on_synced)
